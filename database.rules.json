{
  "rules": {
    "users": {
      "$user_id": {
        ".read":  "$user_id === auth.uid",
        ".write": "$user_id === auth.uid"
      },
	  ".indexOn": ["uid", "isAnonymous"]
    },
    "reports": {
      ".read":  "auth != null",
      ".write": "auth != null"
    },
	"daily": {
	  "head": {
        ".read":  "auth != null",
	  },
	  "head_submit": {
		".read": "auth != null",
		".write": "auth != null",
		".indexOn": ["score"]
	  },
	  "reports": {
	    ".read":  "auth != null"
	  }
    },
	"pvp": {
	  "queue": {
	    ".read": "auth != null",
	    ".indexOn": ["ts"],
	    "$uid": {
	      ".write": "auth != null && auth.uid === $uid",
	      "matchId": {
	        ".write": "auth != null && data.val() === null && newData.val() !== null"
	      }
	    }
	  },
	  "matches": {
	    ".indexOn": ["meta/createdAt"],
	    "$matchId": {
	      ".read": "auth != null",
	      "meta":    { ".write": "auth != null && !data.exists()" },
	      "players": {
	        "$uid": { ".write": "auth != null && auth.uid === $uid" }
	      },
	      "result":  { ".write": "auth != null && !data.exists()" }
	    }
      },
	  "invites": {
	    "$uid": {
	      ".read": "auth != null && auth.uid === $uid",
	      "$fromUid": {
	        ".read": "auth != null && (auth.uid === $uid || auth.uid === $fromUid)",
	        ".write": "auth != null && (auth.uid === $fromUid || auth.uid === $uid) && (auth.uid !== $fromUid || root.child('friends').child($uid).child($fromUid).exists())"
	      }
	    }
	  }
    },
	"pushTokens": {
	  "$uid": {
	    ".write": "auth != null && auth.uid === $uid"
	  }
	},
	"quizCodes": {
	  "$code": {
	    ".read": "auth != null",
	    ".write": "auth != null && newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid)"
	  }
	},
	"friendRequests": {
	  "$uid": {
	    ".read": "auth != null && auth.uid === $uid",
	    "$fromUid": {
	      ".read": "auth != null && auth.uid === $uid",
	      ".write": "auth != null && (auth.uid === $fromUid || auth.uid === $uid)"
	    }
	  }
	},
	"friends": {
	  "$uid": {
	    ".read": "auth != null && auth.uid === $uid",
	    "$friendUid": {
	      ".read": "auth != null && auth.uid === $uid",
	      ".write": "auth != null && (auth.uid === $uid || (auth.uid === $friendUid && (!newData.exists() || root.child('friendRequests').child($friendUid).child($uid).exists())))"
	    }
	  }
	},
	"publicStats": {
	  "$uid": {
	    ".read": "auth != null && (auth.uid === $uid || root.child('friends').child($uid).child(auth.uid).exists())",
	    ".write": "auth != null && auth.uid === $uid"
	  }
	},
	"presence": {
	  "$uid": {
	    ".read": "auth != null",
	    ".write": "auth != null && auth.uid === $uid"
	  }
	},
	"notifPrefs": {
	  "$uid": {
	    ".read": "auth != null && auth.uid === $uid",
	    ".write": "auth != null && auth.uid === $uid"
	  }
	}
  }
}